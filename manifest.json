{
    "name": "Hummingbird",
    "description": "Scrapes post and user information and logs it to an external server.",
    "version": "1.4",
    "manifest_version": 3,
    "action": {
        "default_popup": "popup.html"
    },
    "host_permissions": [
        "https://x.com/*",
        "http://127.0.0.1:8000/*"
    ],
    "permissions": [
        "scripting",
        "storage"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://x.com/*"
            ],
            "js": [
                "config.js",
                "content.js"
            ],
            "css": [
                "content.css"
            ]
        }
    ]
}
